{
  "name": "lspnet-tools-node",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "stamp:version": "echo \"export const GIT_COMMIT_HASH = \\\"$(git rev-parse HEAD)$(git diff-index --quiet HEAD -- || echo '-dirty')\\\";\" > src/version.ts",
    "stamp:buildtime": "echo \"export const BUILD_TIME = \\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\";\" >> src/version.ts",
    "stamp": "npm run stamp:version && npm run stamp:buildtime",
    "build": "npm run stamp && npm run eslint && rm -rf dist/ && tsc && tsc-alias",
    "eslint": "eslint -c eslint.config.ts src/"
  },
  "keywords": [],
  "author": "Kiritow",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@inquirer/prompts": "^8.6.0",
    "commander": "^14.0.3",
    "dayjs": "^1.11.23",
    "ip-address": "^10.5.0",
    "undici": "^8.10.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
